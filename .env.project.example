# Public canonical URL, e.g. https://example.de
NEXT_PUBLIC_SITE_URL=

# Deployment context. Keep preview as the safe default; indexing requires both
# DEPLOYMENT_ENV=production and SEO_INDEXING_ENABLED=true.
DEPLOYMENT_ENV=preview
SEO_INDEXING_ENABLED=false

# Server-side contact form. Keep secrets blank here; never expose them as NEXT_PUBLIC_.
CONTACT_RECIPIENT_EMAIL=info@aktenkompass.de
BREVO_API_KEY=
